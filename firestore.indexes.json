  "fieldOverrides": [
    {
      "//": [
        "device_tokens is written by a callable keyed on sha256(token) and is only",
        "ever read by the push dispatcher, never queried by the client. Exempting",
        "it from automatic single-field indexing removes an index write per token",
        "field on every registration and refresh."
      ],
      "collectionGroup": "device_tokens",
      "fieldPath": "token",
      "indexes": []
    }
  ]
}
