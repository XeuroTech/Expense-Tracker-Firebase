{
  "name": "unity-finance-firebase-functions",
  "description": "Cloud Functions for the Unity Finance Firebase provider. Parallel to backend/functions (Appwrite), which is untouched and keeps running.",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore,auth,storage",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.1",
    "otplib": "^13.4.1"
  }
}
