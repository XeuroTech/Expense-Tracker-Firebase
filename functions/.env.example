# Firebase Functions v2 auto-loads this file at deploy/runtime.
# Copy to .env and fill in real values locally. Never commit .env.

# Turns on Google Authenticator (TOTP) mode for 2FA instead of email OTP.
MFA_USE_TOTP=

# OpenRouter (https://openrouter.ai) — powers aiSmartAdd's AI expense/action
# parsing via src/openRouterService.js. Required for the parse step to work;
# auth, Pro-gating, rate limiting and the confirm/cancel lifecycle work without it.
OPEN_ROUTER_KEY=
# Optional — defaults to z-ai/glm-5.3-flash if unset (see openRouterService.js).
OPEN_ROUTER_MODEL=
